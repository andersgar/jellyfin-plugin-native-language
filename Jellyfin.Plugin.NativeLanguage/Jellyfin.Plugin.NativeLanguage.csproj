<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build for a given Jellyfin release with -p:JellyfinVersion=... -p:JellyfinTfm=... (defaults: Jellyfin 12.1). -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.1.0</JellyfinVersion>
    <JellyfinTfm Condition="'$(JellyfinTfm)' == ''">net10.0</JellyfinTfm>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>$(JellyfinTfm)</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.NativeLanguage</RootNamespace>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Plugins can only embed their own image from Jellyfin 12 on. -->
  <PropertyGroup Condition="!$(JellyfinVersion.StartsWith('10.'))">
    <DefineConstants>$(DefineConstants);EMBEDDED_IMAGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="..\thumb.png" LogicalName="Jellyfin.Plugin.NativeLanguage.thumb.png" />
  </ItemGroup>

</Project>
